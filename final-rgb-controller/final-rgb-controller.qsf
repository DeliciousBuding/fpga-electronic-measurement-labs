# -------------------------------------------------------------------------- #

# Quartus Prime
# Version 25.1std.0 Build 1129 10/21/2025 SC Lite Edition


set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE15F17C8
set_global_assignment -name TOP_LEVEL_ENTITY rgb_controller_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 16
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_global_assignment -name VERILOG_FILE "src/rgb_controller_top.v"
set_global_assignment -name VERILOG_FILE "src/uart_rx_byte.v"
set_global_assignment -name VERILOG_FILE "src/uart_tx_byte.v"
set_global_assignment -name VERILOG_FILE "src/cmd_parser.v"
set_global_assignment -name VERILOG_FILE "src/breath_engine.v"
set_global_assignment -name VERILOG_FILE "src/flow_engine.v"
set_global_assignment -name VERILOG_FILE "src/gradient_engine.v"
set_global_assignment -name VERILOG_FILE "src/ws2812_driver.v"
set_global_assignment -name VERILOG_FILE "src/scene_store.v"

set_global_assignment -name SDC_FILE "final-rgb-controller.sdc"

set_location_assignment PIN_E1 -to clk
set_location_assignment PIN_L2 -to nrst
set_location_assignment PIN_B11 -to rx_din
set_location_assignment PIN_D6 -to tx_dout
set_location_assignment PIN_T2 -to led_din

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nrst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rx_din
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to tx_dout
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_din

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
