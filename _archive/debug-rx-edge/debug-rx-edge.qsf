set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE15F17C8
set_global_assignment -name TOP_LEVEL_ENTITY debug_rx_edge_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE "src/debug_rx_edge_top.v"
set_global_assignment -name SDC_FILE "debug-rx-edge.sdc"

set_location_assignment PIN_E1 -to clk
set_location_assignment PIN_L2 -to nrst
set_location_assignment PIN_K1 -to tx_en
set_location_assignment PIN_D5 -to rx_din
set_location_assignment PIN_D6 -to tx_dout
set_location_assignment PIN_A7 -to tx_busy_flag_qn
set_location_assignment PIN_T2 -to led_din

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to nrst
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to tx_en
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rx_din
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to tx_dout
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to tx_busy_flag_qn
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_din

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"